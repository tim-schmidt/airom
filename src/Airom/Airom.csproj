<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Airom</RootNamespace>
    <AssemblyName>airom</AssemblyName>
  </PropertyGroup>

  <!-- Ship as one native executable with no .NET install required.
       Build with: dotnet publish -c Release

       NativeAOT: the game is compiled to machine code ahead of time, so it
       starts with no warm-up. That is safe here because the game is a port of
       1989 C and uses none of the framework that AOT cannot see through - no
       reflection, no dynamic loading, no serialization. The analyzers agree,
       emitting no trim or AOT warnings at all.

       AOT links with the platform's own native toolchain, so the executable
       can only be built for the machine that builds it: on Windows the MSVC
       "Desktop development with C++" workload, on Linux clang and zlib's
       headers, on a Mac the Xcode command-line tools. It lands in bin/ under
       that machine's runtime identifier - win-x64, osx-arm64, linux-x64.

       No debug symbols beside the executable: they would ship at several times
       its size, for no player's benefit. A crash still names its methods.
       DebugType stops them being made at all; on a Mac the strip step makes a
       .dSYM regardless, and the second property keeps it out of publish/. -->
  <PropertyGroup>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- The help text, which the game reads at run time rather than embedding:
       it is the original's own, and a player may want to read or edit it. -->
  <ItemGroup>
    <Content Include="..\..\help\*">
      <Link>help\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Never opened by the game, but the news screen sends Moria 4.8x
         players to doc/FEATURES.NEW, so it ships where that line says. -->
    <Content Include="..\..\doc\FEATURES.NEW">
      <Link>doc\FEATURES.NEW</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
